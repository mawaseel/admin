rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() {
      return signedIn() && userDoc().data.get('active', true) != false &&
        (userDoc().data.get('role', '') == 'admin' || userDoc().data.get('isAdmin', false) == true);
    }
    function isPrimaryAdmin() {
      return isAdmin() && request.auth.token.email == 'mw.gl3tvl71en6c@mawaseel.ps';
    }
    function hasPermission(name) {
      return isPrimaryAdmin() || (isAdmin() && userDoc().data.get('permissions', {}).get(name, false) == true);
    }
    function partnerDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)); }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'partner') == 'partner'
        && request.resource.data.get('isAdmin', false) == false;

      // المستخدم يعدل بياناته العادية، لكن لا يقدر يوثق/يعتمد نفسه أو يغيّر مراحل الانضمام.
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('role', 'partner') == resource.data.get('role', 'partner')
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false)
        && request.resource.data.get('verificationStatus', 'required') == resource.data.get('verificationStatus', 'required')
        && request.resource.data.get('trialStatus', 'not_started') == resource.data.get('trialStatus', 'not_started')
        && request.resource.data.get('marketerStatus', 'unverified') == resource.data.get('marketerStatus', 'unverified')
        && request.resource.data.get('trialStartedAt', null) == resource.data.get('trialStartedAt', null)
        && request.resource.data.get('trialEndsAt', null) == resource.data.get('trialEndsAt', null)
        && request.resource.data.get('marketerApprovedAt', null) == resource.data.get('marketerApprovedAt', null);

      allow update: if hasPermission('manageAdmins')
        && (isPrimaryAdmin() || resource.data.get('isPrimaryAdmin', false) != true);
      allow delete: if isPrimaryAdmin() && resource.data.get('isPrimaryAdmin', false) != true;
    }

    match /verificationRequests/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('status', '') == 'pending';
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (isAdmin() || resource.data.partnerId == request.auth.uid);
      allow create: if hasPermission('ordersCreate')
        && partnerDoc(request.resource.data.partnerId).data.get('verificationStatus', '') == 'approved'
        && (partnerDoc(request.resource.data.partnerId).data.get('marketerStatus', '') == 'approved'
            || request.resource.data.get('partnerCommission', 0) == 0);
      allow update: if hasPermission('ordersEdit')
        && (partnerDoc(request.resource.data.partnerId).data.get('marketerStatus', '') == 'approved'
            || request.resource.data.get('partnerCommission', 0) == 0);
      allow delete: if hasPermission('ordersDelete');
    }

    match /{document=**} { allow read, write: if false; }
  }
}